{
  "block_id": "condiments/salsa@target",
  "retailer": "target",
  "zip": "condiments",
  "neighborhood": "salsa",
  "term": "salsa",
  "store_zip": "60615",
  "store_js": "document.querySelector('#web-store-id-msg-btn')?.innerText.trim()",
  "steps": [
    {
      "goto": "https://www.target.com/s?searchTerm={{term}}"
    },
    {
      "wait": 7000
    },
    {
      "dismiss": [
        "Close",
        "No thanks",
        "Not now",
        "Continue",
        "Got it"
      ]
    },
    {
      "js": "document.querySelector('#web-store-id-msg-btn').click()"
    },
    {
      "wait": 3000
    },
    {
      "type_sel": {
        "sel": "#zip-code-city-or-state",
        "value": "{{store_zip}}",
        "enter": false
      }
    },
    {
      "click_re": "^Look up$"
    },
    {
      "wait": 5000
    },
    {
      "js": "const d=document.querySelector('[data-test=\"@web/StoreMenu/SelectAStore\"]'); d.querySelector('input[type=radio]').click(); await new Promise(r=>setTimeout(r,800)); d.querySelector('[data-test=\"@web/StoreMenu/ShopThisStoreButton\"]').click(); return 'ok'"
    },
    {
      "wait": 7000
    },
    {
      "scroll": 4
    }
  ]
}