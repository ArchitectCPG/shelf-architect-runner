{
  "block_id": "condiments/salsa@harristeeter",
  "retailer": "harristeeter",
  "zip": "condiments",
  "neighborhood": "salsa",
  "term": "salsa",
  "store_zip": "28202",
  "store_js": "document.querySelector('[data-testid=CurrentModality-button]')?.innerText.replace(/\\s+/g,' ').trim()",
  "steps": [
    {
      "goto": "https://www.harristeeter.com/search?query={{term}}"
    },
    {
      "wait": 7000
    },
    {
      "click_sel": "button[aria-label='close banner']",
      "optional": true
    },
    {
      "wait": 1000
    },
    {
      "click_sel": "[data-testid=CurrentModality-button]"
    },
    {
      "wait": 3000
    },
    {
      "type_sel": {
        "sel": "[data-testid=PostalCodeSearchBox-input]",
        "value": "{{store_zip}}",
        "enter": false
      }
    },
    {
      "js": "const i=document.querySelector('[data-testid=PostalCodeSearchBox-input]'); (i.parentElement.querySelector('button')||i.closest('form')?.querySelector('button')).click(); return 'search'"
    },
    {
      "wait": 6000
    },
    {
      "js": "const d=document.querySelector('[role=dialog],[aria-modal=true]'); const r=d.querySelector('input[type=radio]'); r.click(); await new Promise(x=>setTimeout(x,1000)); d.querySelector('[data-testid=Start-Shopping-PICKUP]').click(); return r.value"
    },
    {
      "wait": 8000
    },
    {
      "click_re": "^Keep Shopping Here$",
      "optional": true
    },
    {
      "wait": 2000
    },
    {
      "goto": "https://www.harristeeter.com/search?query={{term}}"
    },
    {
      "wait": 7000
    },
    {
      "scroll": 4
    }
  ]
}