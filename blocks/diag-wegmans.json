{
 "block_id": "diag/wegmans@wegmans",
 "retailer": "wegmans",
 "zip": "diag",
 "neighborhood": "salsa",
 "store_zip": "14618",
 "steps": [
  {
   "goto": "https://www.wegmans.com/shop/search?query=salsa"
  },
  {
   "wait": 8000
  },
  {
   "dismiss": [
    "Close",
    "No thanks",
    "Not now",
    "Continue",
    "Got it"
   ]
  },
  {
   "js": "const b=[...document.querySelectorAll(\"button[class*='selector-']\")].filter(b=>!/In Store|Pickup|Delivery/i.test(b.innerText))[0]; b.click(); return b.innerText"
  },
  {
   "wait": 3000
  },
  {
   "js": "const d=[...document.querySelectorAll('[role=dialog],[aria-modal=true],[class*=drawer i],[class*=Drawer],[class*=modal i],[class*=Modal]')].filter(e=>e.offsetWidth).pop()||document.body; return [...d.querySelectorAll('input,button,[role=button],[role=radio]')].filter(e=>e.offsetWidth).map(e=>e.tagName[0]+':'+(e.type||'')+':'+(e.placeholder||e.getAttribute('aria-label')||e.innerText||e.id||'').trim().slice(0,45).replace(/\\n/g,' / ')).slice(0,40).join(' || ')"
  },
  {
   "js": "const i=[...document.querySelectorAll(\"input[placeholder='Enter City or Zip']\")].find(e=>e.offsetWidth); if(!i) throw new Error('no input'); i.focus(); i.select&&i.select(); document.execCommand('insertText',false,'{{store_zip}}'); i.dispatchEvent(new Event('input',{bubbles:true})); await new Promise(x=>setTimeout(x,800)); i.dispatchEvent(new KeyboardEvent('keydown',{key:'Enter',code:'Enter',keyCode:13,bubbles:true})); return 'typed into '+(i.placeholder||i.id||i.name||i.getAttribute('aria-label'))"
  },
  {
   "wait": 4000
  },
  {
   "js": "const d=[...document.querySelectorAll('[role=dialog],[aria-modal=true],[class*=drawer i],[class*=Drawer],[class*=modal i],[class*=Modal]')].filter(e=>e.offsetWidth).pop()||document.body; return [...d.querySelectorAll('input,button,[role=button],[role=radio]')].filter(e=>e.offsetWidth).map(e=>e.tagName[0]+':'+(e.type||'')+':'+(e.placeholder||e.getAttribute('aria-label')||e.innerText||e.id||'').trim().slice(0,45).replace(/\\n/g,' / ')).slice(0,40).join(' || ')"
  },
  {
   "js": "const a=[...document.querySelectorAll('input[type=radio],li,[role=option]')].filter(e=>e.offsetWidth).map(e=>(e.tagName+':'+(e.innerText||e.value||'')).slice(0,70).replace(/\\n/g,' / ')).slice(0,15); return a.join(' || ')"
  }
 ]
}