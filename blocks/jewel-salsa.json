{
  "block_id": "condiments/salsa@jewel-osco",
  "retailer": "jewel-osco",
  "zip": "condiments",
  "neighborhood": "salsa",
  "term": "salsa",
  "store_zip": "60615",
  "store_js": "document.querySelector('#fulFillMentAddressNav')?.innerText.replace(/\\s+/g,' ').trim()",
  "steps": [
    {
      "goto": "https://www.jewelosco.com/shop/search-results.html?q={{term}}"
    },
    {
      "wait": 7000
    },
    {
      "dismiss": [
        "Close",
        "No thanks",
        "Not now",
        "Continue",
        "Got it"
      ]
    },
    {
      "press": "Escape"
    },
    {
      "js": "const n=document.querySelector('#fulFillMentAddressNav'); const leaf=[...n.querySelectorAll('*')].filter(e=>e.children.length===0&&e.textContent.trim()).pop()||n; leaf.click(); return leaf.textContent.trim()"
    },
    {
      "wait": 3000
    },
    {
      "type_sel": {
        "sel": "input[placeholder*='ZIP Code']",
        "value": "{{store_zip}}",
        "enter": true
      }
    },
    {
      "wait": 6000
    },
    {
      "js": "const a=Array.from(document.querySelectorAll('.fulfillment-content a')).find(x=>x.innerText.trim()==='Select'); a.click(); return 'selected'"
    },
    {
      "wait": 10000
    },
    {
      "scroll": 4
    },
    {
      "scroll": 2
    },
    {
      "wait": 2000
    },
    {
      "scroll": 2
    },
    {
      "wait": 2000
    },
    {
      "scroll": 2
    },
    {
      "wait": 2000
    }
  ]
}