{
  "block_id": "diag/walmart",
  "retailer": "walmart",
  "zip": "diag",
  "neighborhood": "salsa",
  "store_zip": "60615",
  "no_reload": true,
  "steps": [
    {
      "goto": "https://www.walmart.com/search?q=salsa"
    },
    {
      "wait": 7000
    },
    {
      "dismiss": [
        "Close",
        "No thanks",
        "Not now",
        "Continue"
      ]
    },
    {
      "press": "Escape"
    },
    {
      "click_re": "^Pickup or delivery"
    },
    {
      "wait": 4000
    },
    {
      "dump": "modal"
    },
    {
      "click_re": "^Pickup$",
      "optional": true
    },
    {
      "wait": 3000
    },
    {
      "dump": "pickup-tab"
    },
    {
      "fill": {
        "placeholder": "zip|ZIP|city|Enter|address",
        "value": "{{store_zip}}"
      },
      "optional": true
    },
    {
      "wait": 6000
    },
    {
      "dump": "results"
    }
  ]
}