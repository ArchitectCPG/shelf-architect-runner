{
 "block_id": "diag/costco@browser",
 "retailer": "costco",
 "zip": "diag",
 "neighborhood": "costco",
 "term": "salsa",
 "store_zip": "60615",
 "steps": [
  {
   "goto": "https://www.costco.com/s?keyword={{term}}"
  },
  {
   "wait": 8000
  },
  {
   "dismiss": [
    "Close",
    "No thanks",
    "Not now",
    "Continue",
    "Got it"
   ]
  },
  {
   "js": "return JSON.stringify([...document.querySelectorAll('button,a,[role=button]')].filter(e=>e.offsetWidth&&e.getBoundingClientRect().top<200).map(e=>({t:(e.innerText||e.getAttribute('aria-label')||'').replace(/\\s+/g,' ').trim().slice(0,50),h:e.getAttribute('href')?.slice(0,80)})).filter(x=>x.t))",
   "optional": true
  },
  {
   "scroll": 2
  }
 ]
}